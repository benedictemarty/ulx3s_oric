// Contraintes Tang Nano 20K (GW2AR-LV18QN88C8/I7)
// Brochage d'après la doc Sipeed et MiSTeryNano (source éprouvée).

IO_LOC "clk27" 4;
IO_PORT "clk27" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "btn_s1" 88;
IO_PORT "btn_s1" PULL_MODE=DOWN IO_TYPE=LVCMOS33;

// UART depuis le BL616 (USB-C série)
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;

// HDMI (paires différentielles internes)
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_LOC "tmds_d_p[0]" 35;
IO_LOC "tmds_d_n[0]" 36;
IO_LOC "tmds_d_p[1]" 37;
IO_LOC "tmds_d_n[1]" 38;
IO_LOC "tmds_d_p[2]" 39;
IO_LOC "tmds_d_n[2]" 40;

// LEDs embarquées (actives bas)
IO_LOC "leds_n[0]" 15;
IO_LOC "leds_n[1]" 16;
IO_LOC "leds_n[2]" 17;
IO_LOC "leds_n[3]" 18;
IO_LOC "leds_n[4]" 19;
IO_LOC "leds_n[5]" 20;
IO_PORT "leds_n[0]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_PORT "leds_n[1]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_PORT "leds_n[2]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_PORT "leds_n[3]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_PORT "leds_n[4]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;
IO_PORT "leds_n[5]" PULL_MODE=UP DRIVE=8 IO_TYPE=LVCMOS33;

// Audio sigma-delta sur GPIO (futur PAM8302 de la carte unique)
IO_LOC "audio_pwm" 27;
IO_PORT "audio_pwm" DRIVE=8 IO_TYPE=LVCMOS33;
